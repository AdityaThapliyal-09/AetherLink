<?xml version="1.0" encoding="utf-8"?>
<!-- AetherLink does not use any network connections. This config blocks cleartext. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
